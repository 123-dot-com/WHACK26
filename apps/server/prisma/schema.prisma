generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum GamePhase {
  BRIEFING
  TRADING
  REPORT
  FINISHED
}

enum StockSector {
  TECH
  ENERGY
  FINANCE
}

enum PredictionDirection {
  BULLISH
  NEUTRAL
  BEARISH
}

model GameSession {
  id               String    @id @default(uuid())
  day              Int       @default(1)
  phase            GamePhase @default(BRIEFING)
  seed             Int       @default(2026)
  version          Int       @default(0)
  lastSimulatedDay Int       @default(0)
  wallet           Wallet?
  access           GameAccess?
  holdings         Holding[]
  prices           StockPrice[]
  predictions Prediction[]
}

model Wallet {
  gameId            String      @id
  cashPence         Int         @default(1000000)
  savingsPence      Int         @default(0)
  annualInterestBps Int         @default(400)
  game              GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model Stock {
  id                String      @id
  name              String
  sector            StockSector
  volatility        Float
  initialPricePence Int
  holdings          Holding[]
  prices            StockPrice[]
  predictions Prediction[]
}

model GameAccess {
  gameId String @id
  code   String @unique
  game   GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model Holding{
  gameID String 
  stockID String
  quantity Int @default(0)
  game GameSession @relation(fields: [gameID], references: [id], onDelete: Cascade)
  stock Stock @relation(fields: [stockID], references: [id])

  @@id([gameID, stockID])
}

model StockPrice {
  gameID String
  stockID String
  day Int
  pricePence Int

  game GameSession @relation(fields: [gameID], references: [id], onDelete: Cascade)
  stock Stock @relation(fields: [stockID], references: [id])

  @@id([gameID, stockID, day])
}

model Prediction {
  gameId    String
  day       Int
  stockId   String
  direction PredictionDirection
  game      GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)
  stock     Stock       @relation(fields: [stockId], references: [id])

  @@id([gameId, day])
}